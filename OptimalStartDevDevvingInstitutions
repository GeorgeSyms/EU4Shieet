#   Reman's paradox code

import math
import matplotlib
import matplotlib.pyplot as plt

DevCostMods = 0
rows = []
StartingDev = 3
while StartingDev < 50:
    MP = 0; InstitutePct = 0
    CurrentDev = StartingDev
    while InstitutePct <= 100:
        if CurrentDev > 109:
            raise SystemExit("Development has exceeded maximum specifications")
        IncFromDev = 0
        for k in range(1, 11):                      # brackets >9, >19, ... >99
            th, rate, cap = 10*k - 1, 0.03*k, 0.30*k
            IncFromDev += min(rate*(CurrentDev-th) if CurrentDev > th else 0, cap)
        IncFromDev += 0.00001
        DevCost = math.floor(50*(1 + DevCostMods + IncFromDev))
        MP += DevCost
        CurrentDev += 1
        InstitutePct += CurrentDev/6
    rows.append((StartingDev, MP, CurrentDev))
    StartingDev += 1

best = min(rows, key=lambda r: r[1])
for r in rows: print(r)
print('BEST', best)

# print it 
x = [r[0] for r in rows]; y = [r[1] for r in rows]
title = (f'Monarch points to develop an institution, by starting development '
         f'({DevCostMods*100:.0f}% dev cost modifiers)')
note = f'Minimum: start at {best[0]} dev\n{best[1]:,} monarch points (ends at {best[2]} dev)'

ink, ink2, grid, blue = '#0b0b0b', '#52514e', '#e4e3df', '#2a78d6'
fig, ax = plt.subplots(figsize=(10, 5.6), dpi=150)
fig.patch.set_facecolor('#fcfcfb'); ax.set_facecolor('#fcfcfb')
ax.plot(x, y, color=blue, lw=2, marker='o', ms=4.5, mec='#fcfcfb', mew=1.2, zorder=3)
ax.scatter([best[0]], [best[1]], s=90, color=blue, edgecolor='#fcfcfb', linewidth=2, zorder=4)
ax.annotate(note, xy=(best[0], best[1]), xytext=(0.04, 0.62), textcoords='axes fraction',
            color=ink, fontsize=10, arrowprops=dict(arrowstyle='-', color=ink2, lw=1))
ax.set_title(title, loc='left', color=ink, fontsize=12, pad=12)
ax.set_xlabel('Starting development', color=ink2)
ax.set_ylabel('Total monarch points', color=ink2)
ax.grid(axis='y', color=grid, lw=0.8); ax.set_axisbelow(True)
for s in ('top', 'right', 'left'): ax.spines[s].set_visible(False)
ax.spines['bottom'].set_color('#c9c8c3')
ax.tick_params(colors=ink2, length=0)
ax.set_xticks(range(5, 50, 5)); ax.set_xlim(2, 50)
ax.yaxis.set_major_formatter(matplotlib.ticker.FuncFormatter(lambda v, p: f'{int(v):,}'))
fig.tight_layout()
fig.savefig('dev_vs_mana.png', facecolor=fig.get_facecolor())   # also saved as an image file
plt.show()                                                       # shows in the console / Plots pane
